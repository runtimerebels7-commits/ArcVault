# Set these environment variables in your terminal before starting services.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://127.0.0.1:5500
DATABASE_PATH=arcvault.db

# QpiAI Opt (optional; local mode works without QpiAI credentials)
QPIAI_OPT_BASE_URL=https://opt-server.qpiai.tech/api
# Use an Opt API token/JWT issued for QpiAI Opt, not a Quantum SDK key unless QpiAI confirms they are interchangeable.
QPIAI_OPT_API_KEY=
QPIAI_OPT_MODE=local
# Use the experiment UUID from the QpiAI Opt account; a QCloud Quantum experiment UUID may not work.
QPIAI_OPT_EXPERIMENT_ID=
QPIAI_OPT_COMPUTE_RESOURCE_ID=
QPIAI_OPT_TIMEOUT_SECONDS=120
QPIAI_OPT_POLL_SECONDS=2
QPIAI_OPT_MAX_EVALUATIONS=1000
